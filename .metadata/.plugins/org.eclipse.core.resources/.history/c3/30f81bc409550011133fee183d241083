package com.project.edugov.aspect;

import org.aspectj.lang.annotation.AfterReturning;
import org.aspectj.lang.annotation.Aspect;
import org.springframework.stereotype.Component;

import com.project.edugov.client.AuditClient;
import com.project.edugov.dto.AuditDTO;

import lombok.RequiredArgsConstructor;

@Aspect
@Component
@RequiredArgsConstructor
public class AuditProjectAspect {

	private final AuditClient auditClient;

	// Helper to send to Audit DB
	private void sendAudit(Long userId, String action, String details) {
		AuditDTO dto = new AuditDTO();
		dto.setScope("PROGRAM"); // Strictly as requested
		dto.setFindings("Activity: " + action + " | Details: " + details);
		dto.setStatus("PENDING_VALIDATION");
		dto.setOfficerId(userId != null ? userId : 0L);
		auditClient.createAuditEntry(dto);
	}

	// --- PROGRAM SERVICE HOOKS ---
	@AfterReturning("execution(* com.project.edugov.service.ProgramServiceImpl.createProgram(..)) && args(program, adminId)")
	public void afterCreateProgram(Object program, Long adminId) {
		sendAudit(adminId, "CREATE_PROGRAM", "Created new program");
	}

	@AfterReturning("execution(* com.project.edugov.service.ProgramServiceImpl.updateProgramById(..)) && args(id, details)")
	public void afterUpdateProgram(Long id, Object details) {
		sendAudit(0L, "UPDATE_PROGRAM", "Updated Program ID: " + id);
	}

	// --- COURSE SERVICE HOOKS ---
	@AfterReturning("execution(* com.project.edugov.service.CourseServiceImpl.createCourse(..)) && args(course, adminId)")
	public void afterCreateCourse(Object course, Long adminId) {
		sendAudit(adminId, "CREATE_COURSE", "New course added");
	}

	@AfterReturning("execution(* com.project.edugov.service.CourseServiceImpl.updateCourse(..)) && args(id, details)")
	public void afterUpdateCourse(Long id, Object details) {
		sendAudit(0L, "UPDATE_COURSE", "Updated Course ID: " + id);
	}

	// --- ENROLLMENT SERVICE HOOKS ---
	@AfterReturning("execution(* com.project.edugov.service.EnrollmentServiceImpl.applyForCourse(..)) && args(sId, cId)")
	public void afterApply(Long sId, Long cId) {
		sendAudit(sId, "ENROLLMENT_APPLICATION", "Student ID: " + sId + " applied for Course ID: " + cId);
	}

	@AfterReturning("execution(* com.project.edugov.service.EnrollmentServiceImpl.updateEnrollmentStatus(..)) && args(data)")
	public void afterUpdateStatus(Object data) {
		// Here you can cast 'data' to Map if you need specific ID extraction
		sendAudit(0L, "ENROLLMENT_STATUS_CHANGE", "Status updated for enrollment");
	}

	@AfterReturning("execution(* com.project.edugov.service.EnrollmentServiceImpl.deleteEnrollment(..)) && args(eId, aId)")
	public void afterDeleteEnrollment(Long eId, Long aId) {
		sendAudit(aId, "DELETE_ENROLLMENT", "Deleted Enrollment ID: " + eId);
	}
}